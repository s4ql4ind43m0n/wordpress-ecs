{
  "family": "mysql-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "volumes": [
    {
      "name": "mysql-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-<MYSQL_EFS_ID>",
        "rootDirectory": "/"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "mysql",
      "image": "mysql:8.4",
      "essential": true,
      "portMappings": [
        { "name": "mysql", "containerPort": 3306, "protocol": "tcp" }
      ],
      "mountPoints": [
        { "sourceVolume": "mysql-data", "containerPath": "/var/lib/mysql", "readOnly": false }
      ],
      "secrets": [
        { "name": "MYSQL_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:wordpress/staging/database-<SECRET_SUFFIX>:username::" },
        { "name": "MYSQL_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:wordpress/staging/database-<SECRET_SUFFIX>:password::" },
        { "name": "MYSQL_DATABASE", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:wordpress/staging/database-<SECRET_SUFFIX>:database::" },
        { "name": "MYSQL_ROOT_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:wordpress/staging/database-<SECRET_SUFFIX>:root_password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/wordpress-staging",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "wordpress/mysql"
        }
      }
    }
  ]
}
