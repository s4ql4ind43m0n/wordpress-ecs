{
  "family": "wordpress-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/wordpressTaskRole",
  "volumes": [
    {
      "name": "wordpress-files",
      "efsVolumeConfiguration": {
        "fileSystemId": "<WORDPRESS_EFS_FILESYSTEM_ID>",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/wordpress-nginx:<IMAGE_TAG>",
      "essential": true,
      "cpu": 256,
      "memory": 256,
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }],
      "mountPoints": [
        { "sourceVolume": "wordpress-files", "containerPath": "/var/www/html" }
      ],
      "dependsOn": [{ "containerName": "php", "condition": "START" }],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/wordpress-staging",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "wordpress/nginx"
        }
      }
    },
    {
      "name": "php",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/wordpress-php:<IMAGE_TAG>",
      "essential": true,
      "cpu": 768,
      "memory": 1536,
      "portMappings": [{ "containerPort": 9000, "protocol": "tcp" }],
      "mountPoints": [
        { "sourceVolume": "wordpress-files", "containerPath": "/var/www/html" }
      ],
      "environment": [
        { "name": "DB_HOST", "value": "mysql" },
        { "name": "DB_NAME", "value": "wordpress" }
      ],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:wordpress/staging/database:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:wordpress/staging/database:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/wordpress-staging",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "wordpress/php"
        }
      }
    }
  ]
}
